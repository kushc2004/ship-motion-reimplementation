.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.venv*/

# Project-local Kaggle CLI credentials.  The wrapper in scripts/kaggle.sh
# points KAGGLE_CONFIG_DIR here, so this repository can use a different
# Kaggle account without changing the user's global CLI configuration.
.kaggle/

# Reproducible source data and immutable manifests are versioned.  Generated
# benchmark/model outputs are intentionally local so no legacy metric is
# republished as a new result.
outputs/
kaggle_artifact_store/primary_benchmark_m37/
kaggle_artifact_store/m8_m12/
kaggle_artifact_store/reports/
kaggle_artifact_store/figures/
kaggle_artifact_store/cv/
BTP-2/BTP2_outputs/
BTP-2/Latex_Report.zip
BTP-2/Latex_Report/figures/

# Notebook checkpoints and local editor state.
.ipynb_checkpoints/
.vscode/
